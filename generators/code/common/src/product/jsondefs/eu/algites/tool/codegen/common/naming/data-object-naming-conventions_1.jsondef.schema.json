{
  "$schema": "https://defs.dev.algites.eu/api/jsonmetadefs/eu/algites/tool/codegen/defs/jsonmetadef/2020-12/dialect_1.jsonmetadef.schema.json",
  "$id": "https://defs.dev.algites.eu/api/jsondefs/eu/algites/tool/codegen/common/naming/data-object-naming-conventions_1.jsondef.schema.json",
  "title": "DataObject method naming conventions",
  "description": "Method naming profiles using the common naming composition toolkit.",
  "x-algites-schema-id": "eu.algites.tool.codegen.common.naming.data-object-naming-conventions",
  "x-algites-schema-version": 1,
  "x-algites-defscodegen-extends": [
    "https://defs.dev.algites.eu/api/jsondefs/eu/algites/lib/naming/convention/common-naming-conventions_1.jsondef.schema.json"
  ],
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/jsondefs/eu/algites/lib/naming/convention/common-naming-conventions_1.jsondef.schema.json"
    }
  ],
  "properties": {
    "GeneratedDataObjectMethodNameConventions": {
      "type": "object",
      "properties": {
        "NameConventions": {
          "type": "object",
          "title": "NameConvention collection",
          "description": "",
          "additionalProperties": false,
          "properties": {
            "NameConvention": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GeneratedDataObjectMethodNameConvention"
              },
              "description": "Ordered XSD NameConvention elements; name is an identity attribute.",
              "x-algites-defscodegen-key": {
                "id": "UniqueMethodNamingProfiles",
                "field-name": "name"
              }
            }
          }
        }
      },
      "required": [
        "NameConventions"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "GeneratedDataObjectMethodNameConventions"
  ],
  "$defs": {
    "GeneratedDataObjectMethodNameConvention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Required XSD identity attribute."
        },
        "StructureNaming": {
          "type": "object",
          "title": "Naming rules",
          "description": "Standard getters/setters are required; absent or empty raw method roles disable generation of the corresponding method.",
          "additionalProperties": false,
          "properties": {
            "Rule": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GeneratedDataObjectMethodStructureNamingRule"
              },
              "x-algites-defscodegen-key": {
                "id": "UniqueMethodKinds",
                "field-name": "kind"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "standard_getter"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "standard_setter"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                }
              ]
            }
          }
        },
        "SchemaMetadataNaming": {
          "type": "object",
          "title": "Schema metadata field naming roles",
          "description": "Maps the six metadata roles to actual source-schema and serialized-document field names. Omitted or empty role mappings disable extraction/emission. All keys are restricted by the shared enum.",
          "additionalProperties": false,
          "properties": {
            "Rule": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GeneratedDataObjectMethodSchemaMetadataNamingRule"
              },
              "x-algites-defscodegen-key": {
                "id": "UniqueSchemaMetadataKinds",
                "field-name": "kind"
              }
            }
          }
        }
      },
      "required": [
        "name",
        "StructureNaming",
        "SchemaMetadataNaming"
      ]
    },
    "GeneratedDataObjectMethodStructureNamingRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "generated-dataobject-structure-kind_1.jsondef.schema.json"
        },
        "Value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "Value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "standard_getter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Required generated accessor composition ID."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "standard_setter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Required generated accessor composition ID."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "list_getter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Optional named composition for get<Field>List accessors. The new split Common profile requires it."
              }
            }
          }
        }
      ]
    },
    "GeneratedDataObjectMethodSchemaMetadataNamingRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "generated-dataobject-schema-metadata-kind_1.jsondef.schema.json"
        },
        "Value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "Value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "schema_source_schema_url"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "default": "",
                "description": "Name of the source schema declaration field that identifies the schema URI (for example $id). Blank disables extraction."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "schema_source_schema_identifier"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "default": "",
                "description": "Name of the source schema declaration field containing its logical schema identifier. Blank disables extraction."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "schema_source_schema_version"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "default": "",
                "description": "Name of the source schema declaration field containing its logical schema version. Blank disables extraction."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "data_source_schema_url"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "default": "",
                "description": "Name of the serialized instance document field containing the schema URI (for example $schema). Blank disables emission and reading. Requires schema_source_schema_url."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "data_source_schema_identifier"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "default": "",
                "description": "Name of the serialized instance document field containing the logical schema identifier. Blank disables emission and reading. Requires schema_source_schema_identifier."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "data_source_schema_version"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "default": "",
                "description": "Name of the serialized instance document field containing the logical schema version. Blank disables emission and reading. Requires schema_source_schema_version."
              }
            }
          }
        }
      ]
    }
  }
}
