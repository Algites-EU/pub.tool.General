<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/tool/codegen/common/naming/codegen-common-structure-kind_1.xsd" xmlns:tns="https://defs.dev.algites.eu/api/xmldefs/eu/algites/tool/codegen/common/naming/codegen-common-structure-kind_1.xsd" version="1">
  <xs:annotation><xs:documentation>Valid common naming roles; each value is documented separately. This schema supersedes the mixed method role enum for the new codegen.</xs:documentation></xs:annotation>
  <xs:simpleType name="CodegenCommonStructureKind"><xs:restriction base="xs:string">
    <xs:enumeration value="standard_getter"><xs:annotation><xs:documentation>Generated typed getter; compositional name rule shared by Defs and SDO.</xs:documentation></xs:annotation></xs:enumeration>
    <xs:enumeration value="list_getter"><xs:annotation><xs:documentation>Getter for a repeated schema field; uses a configured composition, for example getRuleList instead of getRules.</xs:documentation></xs:annotation></xs:enumeration>
    <xs:enumeration value="standard_setter"><xs:annotation><xs:documentation>Generated typed setter; compositional name rule shared by Defs and SDO.</xs:documentation></xs:annotation></xs:enumeration>
    <xs:enumeration value="multi_mapped_list_key_synthetic_getter"><xs:annotation><xs:documentation>Literal synthetic getter for a JSON/YAML map entry key; no serialized field.</xs:documentation></xs:annotation></xs:enumeration>
    <xs:enumeration value="multi_mapped_list_value_synthetic_getter"><xs:annotation><xs:documentation>Literal synthetic getter for a JSON/YAML map entry value; no serialized field.</xs:documentation></xs:annotation></xs:enumeration>
    <xs:enumeration value="positional_item_synthetic_getter"><xs:annotation><xs:documentation>Naming composition for a positional prefixItems accessor, with a configurable displayed position.</xs:documentation></xs:annotation></xs:enumeration>
    <xs:enumeration value="const_container_interface"><xs:annotation><xs:documentation>Naming composition for nested generated CONST interface.</xs:documentation></xs:annotation></xs:enumeration>
  </xs:restriction></xs:simpleType>
</xs:schema>
