<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="eu.algites.tool.codegen.common.naming.generated-dataobject-schema-metadata-kind" version="1">
	<xs:annotation>
		<xs:documentation>Six metadata naming roles for source schema metadata and serialized DataObject metadata. These roles are not
			generated method names.
		</xs:documentation>
	</xs:annotation>
	<xs:simpleType name="GeneratedDataobjectSchemaMetadataKind">
		<xs:restriction base="xs:string">
			<xs:enumeration value="schema_source_schema_url">
				<xs:annotation>
					<xs:documentation>Name of the source schema declaration field that identifies the schema URI (for example $id). Blank
						disables extraction.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="schema_source_schema_identifier">
				<xs:annotation>
					<xs:documentation>Name of the source schema declaration field containing its logical schema identifier. Blank disables
						extraction.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="schema_source_schema_version">
				<xs:annotation>
					<xs:documentation>Name of the source schema declaration field containing its logical schema version. Blank disables
						extraction.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="data_source_schema_url">
				<xs:annotation>
					<xs:documentation>Name of the serialized instance document field containing the schema URI (for example $schema). Blank
						disables emission and reading. Requires schema_source_schema_url.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="data_source_schema_identifier">
				<xs:annotation>
					<xs:documentation>Name of the serialized instance document field containing the logical schema identifier. Blank
						disables emission and reading. Requires schema_source_schema_identifier.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="data_source_schema_version">
				<xs:annotation>
					<xs:documentation>Name of the serialized instance document field containing the logical schema version. Blank disables
						emission and reading. Requires schema_source_schema_version.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
