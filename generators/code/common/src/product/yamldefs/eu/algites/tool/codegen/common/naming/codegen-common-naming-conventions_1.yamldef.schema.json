{
  "$schema": "https://defs.dev.algites.eu/api/jsonmetadefs/eu/algites/tool/codegen/defs/jsonmetadef/2020-12/dialect_1.jsonmetadef.schema.json",
  "$id": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/tool/codegen/common/naming/codegen-common-naming-conventions_1.yamldef.schema.json",
  "title": "CommonCodegenNameConventions",
  "description": "New common naming profiles; other-domain roles forbidden.",
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.yamldef.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "CommonCodegenNameConventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "NameConventions": {
          "type": "object",
          "title": "NameConvention collection",
          "description": "",
          "additionalProperties": false,
          "properties": {
            "NameConvention": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CommonCodegenNameConvention"
              },
              "description": "Ordered XSD NameConvention elements; name is an identity attribute.",
              "x-algites-defscodegen-key": {
                "id": "UniqueProfileIds",
                "field-name": "name"
              }
            }
          }
        }
      },
      "required": [
        "NameConventions"
      ]
    }
  },
  "required": [
    "CommonCodegenNameConventions"
  ],
  "x-algites-defscodegen-extends": [
    "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.yamldef.schema.json"
  ],
  "x-algites-schema-id": "eu.algites.tool.codegen.common.naming.codegen-common-naming-conventions",
  "x-algites-schema-version": 1,
  "$defs": {
    "CommonCodegenNameConvention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Required XSD identity attribute."
        },
        "StructureNaming": {
          "type": "object",
          "title": "Naming rules",
          "description": "Role names are restricted to the common domain. Values reference naming compositions except the two literal key/value getters.",
          "additionalProperties": false,
          "properties": {
            "Rule": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CommonCodegenStructureNamingRule"
              },
              "x-algites-defscodegen-key": {
                "id": "UniqueStructureRoles",
                "field-name": "kind"
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "standard_getter"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "list_getter"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "standard_setter"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                }
              ]
            }
          }
        },
        "SchemaMetadataNaming": {
          "type": "object",
          "title": "Naming rules",
          "description": "Six metadata bindings, with disabled roles represented by omitted/empty/null values.",
          "additionalProperties": false,
          "properties": {
            "Rule": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CommonCodegenSchemaMetadataNamingRule"
              }
            }
          }
        },
        "IndexesStartingFrom": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "First suffix in generated positional getter/type names (e.g. prefixItems), not data indexes or enum values."
        }
      },
      "required": [
        "name",
        "StructureNaming"
      ]
    },
    "CommonCodegenStructureNamingRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/tool/codegen/common/naming/codegen-common-structure-kind_1.yamldef.schema.json"
        },
        "Value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "Value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "standard_getter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Generated typed getter; compositional name rule shared by Defs and SDO."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "standard_setter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Generated typed setter; compositional name rule shared by Defs and SDO."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "positional_item_synthetic_getter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Naming composition for a positional prefixItems accessor, with a configurable displayed position."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multi_mapped_list_key_synthetic_getter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Literal synthetic getter for a JSON/YAML map entry key; no serialized field."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "multi_mapped_list_value_synthetic_getter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Literal synthetic getter for a JSON/YAML map entry value; no serialized field."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "const_container_interface"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Composition for the nested generated CONST interface used by Defs and SDO."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "list_getter"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "Value": {
                "type": "string",
                "minLength": 1,
                "description": "Required composition for a typed getter of a repeated field. Uses the field singular name as a role input; e.g. getRuleList."
              }
            }
          }
        }
      ]
    },
    "CommonCodegenSchemaMetadataNamingRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/tool/codegen/common/naming/generated-dataobject-schema-metadata-kind_1.yamldef.schema.json"
        },
        "Value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "Value"
      ]
    }
  }
}
