{
  "$schema": "https://defs.dev.algites.eu/api/jsonmetadefs/eu/algites/tool/codegen/defs/jsonmetadef/2020-12/dialect_1.jsonmetadef.schema.json",
  "$id": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/tool/codegen/common/naming/data-object-naming-conventions_1.yamldef.schema.json",
  "title": "DataObject method naming conventions",
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.yamldef.schema.json"
    }
  ],
  "description": "Method naming profiles using the common naming composition toolkit.",
  "properties": {
    "GeneratedDataObjectMethodNameConventions": {
      "type": "object",
      "properties": {
        "NameConventions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "StructureNaming": {
                "type": "object",
                "propertyNames": {
                  "$ref": "generated-dataobject-structure-kind_1.yamldef.schema.json"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "required": [
                  "standard_getter",
                  "standard_setter"
                ],
                "description": "Standard getters/setters are required; absent or empty raw method roles disable generation of the corresponding method.",
                "properties": {
                  "standard_getter": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Required generated accessor composition ID."
                  },
                  "standard_setter": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Required generated accessor composition ID."
                  }
                }
              },
              "SchemaMetadataNaming": {
                "type": "object",
                "title": "Schema metadata field naming roles",
                "description": "Maps the six metadata roles to actual source-schema and serialized-document field names. Omitted or empty role mappings disable extraction/emission. All keys are restricted by the shared enum.",
                "propertyNames": {
                  "$ref": "generated-dataobject-schema-metadata-kind_1.yamldef.schema.json"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "properties": {
                  "schema_source_schema_url": {
                    "type": "string",
                    "default": "",
                    "description": "Name of the source schema declaration field that identifies the schema URI (for example $id). Blank disables extraction."
                  },
                  "schema_source_schema_identifier": {
                    "type": "string",
                    "default": "",
                    "description": "Name of the source schema declaration field containing its logical schema identifier. Blank disables extraction."
                  },
                  "schema_source_schema_version": {
                    "type": "string",
                    "default": "",
                    "description": "Name of the source schema declaration field containing its logical schema version. Blank disables extraction."
                  },
                  "data_source_schema_url": {
                    "type": "string",
                    "default": "",
                    "description": "Name of the serialized instance document field containing the schema URI (for example $schema). Blank disables emission and reading. Requires schema_source_schema_url."
                  },
                  "data_source_schema_identifier": {
                    "type": "string",
                    "default": "",
                    "description": "Name of the serialized instance document field containing the logical schema identifier. Blank disables emission and reading. Requires schema_source_schema_identifier."
                  },
                  "data_source_schema_version": {
                    "type": "string",
                    "default": "",
                    "description": "Name of the serialized instance document field containing the logical schema version. Blank disables emission and reading. Requires schema_source_schema_version."
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "data_source_schema_url"
                      ],
                      "properties": {
                        "data_source_schema_url": {
                          "minLength": 1
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "schema_source_schema_url"
                      ],
                      "properties": {
                        "schema_source_schema_url": {
                          "minLength": 1
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "data_source_schema_identifier"
                      ],
                      "properties": {
                        "data_source_schema_identifier": {
                          "minLength": 1
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "schema_source_schema_identifier"
                      ],
                      "properties": {
                        "schema_source_schema_identifier": {
                          "minLength": 1
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "data_source_schema_version"
                      ],
                      "properties": {
                        "data_source_schema_version": {
                          "minLength": 1
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "schema_source_schema_version"
                      ],
                      "properties": {
                        "schema_source_schema_version": {
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "StructureNaming",
              "SchemaMetadataNaming"
            ]
          }
        }
      },
      "required": [
        "NameConventions"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "GeneratedDataObjectMethodNameConventions"
  ],
  "x-algites-defscodegen-extends": [
    "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.yamldef.schema.json"
  ],
  "x-algites-schema-id": "eu.algites.tool.codegen.common.naming.data-object-naming-conventions",
  "x-algites-schema-version": 1
}
