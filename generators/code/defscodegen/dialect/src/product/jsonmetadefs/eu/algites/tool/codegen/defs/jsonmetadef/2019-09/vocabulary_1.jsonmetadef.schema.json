{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://defs.dev.algites.eu/api/jsonmetadefs/eu/algites/tool/codegen/defs/jsonmetadef/2019-09/vocabulary_1.jsonmetadef.schema.json",
  "title": "Algites Defs Codegen vocabulary 1 keyword syntax for JSON Schema 2019-09",
  "description": "Keyword syntax only; semantic interpretation is specified by vocabulary_1.md.",
  "type": [
    "object",
    "boolean"
  ],
  "properties": {
    "x-algites-defscodegen-extends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri-reference"
      },
      "description": "Nominal direct parents of the generated object interface; does not perform JSON Schema instance validation."
    },
    "x-algites-defscodegen-choice": {
      "const": true,
      "description": "Explicit Defs Codegen exclusive choice over sibling properties; minProperties=1, maxProperties=1 and additionalProperties=false ensure standard JSON validation where supported. May only appear in structural schema positions."
    }
  },
  "if": {
    "required": [
      "x-algites-defscodegen-choice"
    ],
    "type": "object"
  },
  "then": {
    "required": [
      "type",
      "properties",
      "minProperties",
      "maxProperties",
      "additionalProperties"
    ],
    "properties": {
      "type": {
        "enum": [
          "object"
        ]
      },
      "properties": {
        "type": "object",
        "minProperties": 2
      },
      "minProperties": {
        "enum": [
          1
        ]
      },
      "maxProperties": {
        "enum": [
          1
        ]
      },
      "additionalProperties": {
        "enum": [
          false
        ]
      }
    },
    "not": {
      "anyOf": [
        {
          "required": [
            "patternProperties"
          ]
        },
        {
          "required": [
            "required"
          ]
        }
      ]
    }
  }
}
