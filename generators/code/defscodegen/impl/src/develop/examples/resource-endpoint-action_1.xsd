<?xml version='1.0' encoding='utf-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:algdoc="urn:eu:algites:documentation:1" targetNamespace="example.resource-endpoint-action" version="1">
  <xs:annotation>
    <xs:appinfo><algdoc:title>Resource endpoint action</algdoc:title></xs:appinfo>
    <xs:documentation>Example canonical enum definition for resource endpoint actions.</xs:documentation>
  </xs:annotation>
  <xs:import namespace="urn:eu:algites:documentation:1" schemaLocation="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/common/documentation/algites-documentation_1.xsd"/>
  <xs:simpleType name="resource-endpoint-action">
    <xs:annotation>
      <xs:appinfo><algdoc:title>Resource endpoint action</algdoc:title></xs:appinfo>
      <xs:documentation>Defines one resource endpoint action value set.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="download">
        <xs:annotation><xs:appinfo><algdoc:title>Download</algdoc:title></xs:appinfo>
      <xs:documentation>Reads resources from the example XML-defined endpoint.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="upload">
        <xs:annotation><xs:appinfo><algdoc:title>Upload</algdoc:title></xs:appinfo>
      <xs:documentation>Publishes resources to the example XML-defined endpoint.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="manage">
        <xs:annotation><xs:appinfo><algdoc:title>Manage</algdoc:title></xs:appinfo>
      <xs:documentation>Performs management operations on the example XML-defined endpoint.</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
