<xs:element name="timeValue" minOccurs="1" type="xs:time"><xs:annotation><xs:appinfo><algdoc:title>Time value</algdoc:title></xs:appinfo>
      <xs:documentation>Time with preserved fractional precision.</xs:documentation></xs:annotation></xs:element>
<xs:element name="timestamp" minOccurs="1" type="xs:dateTime"><xs:annotation><xs:appinfo><algdoc:title>Timestamp</algdoc:title></xs:appinfo>
      <xs:documentation>Timestamp with preserved timezone.</xs:documentation></xs:annotation></xs:element>
<xs:element name="durationValue" minOccurs="1" type="xs:duration"><xs:annotation><xs:appinfo><algdoc:title>Duration value</algdoc:title></xs:appinfo>
      <xs:documentation>Calendar duration with months and exact seconds.</xs:documentation></xs:annotation></xs:element>
<xs:element name="binaryHex" minOccurs="1" type="xs:hexBinary"><xs:annotation><xs:appinfo><algdoc:title>Binary hex</algdoc:title></xs:appinfo>
      <xs:documentation>Hexadecimal binary content.</xs:documentation></xs:annotation></xs:element>
<xs:element name="binaryBase64" minOccurs="1" type="xs:base64Binary"><xs:annotation><xs:appinfo><algdoc:title>Binary base64</algdoc:title></xs:appinfo>
      <xs:documentation>Base64 binary content.</xs:documentation></xs:annotation></xs:element>
<xs:element name="boundedText" minOccurs="1"><xs:annotation><xs:appinfo><algdoc:title>Bounded text</algdoc:title></xs:appinfo>
      <xs:documentation>Text constrained by length and pattern.</xs:documentation></xs:annotation><xs:simpleType><xs:annotation><xs:appinfo><algdoc:title>Bounded text type</algdoc:title></xs:appinfo><xs:documentation>Text restriction requiring uppercase letters and between two and five characters.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:minLength value="2"/><xs:maxLength value="5"/><xs:pattern value="[A-Z]+"/></xs:restriction></xs:simpleType></xs:element>
<xs:element name="boundedInteger" minOccurs="1"><xs:annotation><xs:appinfo><algdoc:title>Bounded integer</algdoc:title></xs:appinfo>
      <xs:documentation>Integer constrained by exact boundaries.</xs:documentation></xs:annotation><xs:simpleType><xs:annotation><xs:appinfo><algdoc:title>Bounded integer type</algdoc:title></xs:appinfo><xs:documentation>Integer restriction with values between minus four and eight, inclusive.</xs:documentation></xs:annotation><xs:restriction base="xs:integer"><xs:minInclusive value="-4"/><xs:maxInclusive value="8"/></xs:restriction></xs:simpleType></xs:element>
<xs:element name="boundedDecimal" minOccurs="1"><xs:annotation><xs:appinfo><algdoc:title>Bounded decimal</algdoc:title></xs:appinfo>
      <xs:documentation>Decimal constrained by an exclusive upper boundary.</xs:documentation></xs:annotation><xs:simpleType><xs:annotation><xs:appinfo><algdoc:title>Bounded decimal type</algdoc:title></xs:appinfo><xs:documentation>Decimal restriction permitting values from zero inclusive to 2.5 exclusive.</xs:documentation></xs:annotation><xs:restriction base="xs:decimal"><xs:minInclusive value="0"/><xs:maxExclusive value="2.5"/></xs:restriction></xs:simpleType></xs:element>
<xs:element name="inlineState" minOccurs="1"><xs:annotation><xs:appinfo><algdoc:title>Inline state</algdoc:title></xs:appinfo>
      <xs:documentation>Inline scalar restriction remains a string.</xs:documentation></xs:annotation><xs:simpleType><xs:annotation><xs:appinfo><algdoc:title>Inline state type</algdoc:title></xs:appinfo><xs:documentation>String restriction allowing only the first and second state values.</xs:documentation></xs:annotation><xs:restriction base="xs:string"><xs:enumeration value="first"><xs:annotation><xs:appinfo><algdoc:title>First</algdoc:title></xs:appinfo>
      <xs:documentation>Selects the first option in the corresponding enumeration.</xs:documentation></xs:annotation>
    </xs:enumeration><xs:enumeration value="second"><xs:annotation><xs:appinfo><algdoc:title>Second</algdoc:title></xs:appinfo>
      <xs:documentation>Selects the second option in the corresponding enumeration.</xs:documentation></xs:annotation>
    </xs:enumeration></xs:restriction></xs:simpleType></xs:element>
</xs:sequence>
</xs:complexType>
