<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="urn:parity:xmldefs:parity-root:1" xmlns:s0="urn:parity:xmldefs:parity-child:1" xmlns:s1="urn:parity:xmldefs:parity-status:1" xmlns:algdoc="urn:eu:algites:documentation:1" targetNamespace="urn:parity:xmldefs:parity-root:1" version="1" elementFormDefault="qualified">
<xs:annotation><xs:appinfo><algdoc:title>Parity root</algdoc:title></xs:appinfo>
