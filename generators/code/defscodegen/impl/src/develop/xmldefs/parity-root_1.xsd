<xs:sequence>
<xs:element name="text" minOccurs="1" type="xs:string"><xs:annotation><xs:appinfo><algdoc:title>Text</algdoc:title></xs:appinfo>
      <xs:documentation>Required text value.</xs:documentation></xs:annotation></xs:element>
<xs:element name="count" minOccurs="1" type="xs:integer"><xs:annotation><xs:appinfo><algdoc:title>Count</algdoc:title></xs:appinfo>
      <xs:documentation>Required integer value.</xs:documentation></xs:annotation></xs:element>
<xs:element name="amount" minOccurs="1" type="xs:decimal"><xs:annotation><xs:appinfo><algdoc:title>Amount</algdoc:title></xs:appinfo>
      <xs:documentation>Required floating-point value.</xs:documentation></xs:annotation></xs:element>
<xs:element name="enabled" minOccurs="1" type="xs:boolean"><xs:annotation><xs:appinfo><algdoc:title>Enabled</algdoc:title></xs:appinfo>
      <xs:documentation>Required boolean value.</xs:documentation></xs:annotation></xs:element>
<xs:element name="optionalText" minOccurs="0" type="xs:string"><xs:annotation><xs:appinfo><algdoc:title>Optional text</algdoc:title></xs:appinfo>
      <xs:documentation>Optional text value.</xs:documentation></xs:annotation></xs:element>
<xs:element name="nullableText" minOccurs="1" nillable="true" type="xs:string"><xs:annotation><xs:appinfo><algdoc:title>Nullable text</algdoc:title></xs:appinfo>
      <xs:documentation>Required nullable text value.</xs:documentation></xs:annotation></xs:element>
<xs:element name="optionalNullableText" minOccurs="0" nillable="true" type="xs:string"><xs:annotation><xs:appinfo><algdoc:title>Optional nullable text</algdoc:title></xs:appinfo>
      <xs:documentation>Optional nullable text value.</xs:documentation></xs:annotation></xs:element>
<xs:element name="child" minOccurs="1" type="s0:Contract"><xs:annotation><xs:appinfo><algdoc:title>Child</algdoc:title></xs:appinfo>
      <xs:documentation>Child object from a subschema.</xs:documentation></xs:annotation></xs:element>
<xs:element name="children" minOccurs="1" maxOccurs="unbounded" type="s0:Contract"><xs:annotation><xs:appinfo><algdoc:title>Children</algdoc:title></xs:appinfo>
      <xs:documentation>Collection of child objects.</xs:documentation></xs:annotation></xs:element>
<xs:element name="status" minOccurs="1" type="s1:Contract"><xs:annotation><xs:appinfo><algdoc:title>Status</algdoc:title></xs:appinfo>
      <xs:documentation>State from an enum subschema.</xs:documentation></xs:annotation></xs:element>
<xs:element name="statuses" minOccurs="1" maxOccurs="unbounded" type="s1:Contract"><xs:annotation><xs:appinfo><algdoc:title>Statuses</algdoc:title></xs:appinfo>
      <xs:documentation>Collection of enum values.</xs:documentation></xs:annotation></xs:element>
<xs:element name="texts" minOccurs="1" maxOccurs="unbounded" type="xs:string"><xs:annotation><xs:appinfo><algdoc:title>Texts</algdoc:title></xs:appinfo>
      <xs:documentation>Collection of strings.</xs:documentation></xs:annotation></xs:element>
<xs:element name="counts" minOccurs="1" maxOccurs="unbounded" type="xs:integer"><xs:annotation><xs:appinfo><algdoc:title>Counts</algdoc:title></xs:appinfo>
      <xs:documentation>Collection of integers.</xs:documentation></xs:annotation></xs:element>
<xs:element name="amounts" minOccurs="1" maxOccurs="unbounded" type="xs:decimal"><xs:annotation><xs:appinfo><algdoc:title>Amounts</algdoc:title></xs:appinfo>
