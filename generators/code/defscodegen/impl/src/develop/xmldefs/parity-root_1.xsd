      <xs:documentation>Collection of booleans.</xs:documentation></xs:annotation></xs:element>
<xs:element name="freeObject" minOccurs="1"><xs:annotation><xs:appinfo><algdoc:title>Free object</algdoc:title></xs:appinfo>
      <xs:documentation>Unconstrained object value.</xs:documentation></xs:annotation><xs:complexType><xs:annotation><xs:appinfo><algdoc:title>Free object type</algdoc:title></xs:appinfo><xs:documentation>Unrestricted object structure accepting arbitrary XML child elements.</xs:documentation></xs:annotation><xs:sequence><xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/></xs:sequence></xs:complexType></xs:element>
<xs:element name="inlineObject" minOccurs="1"><xs:annotation><xs:appinfo><algdoc:title>Inline object</algdoc:title></xs:appinfo>
      <xs:documentation>Inline nested object; its fields must not leak into the parent.</xs:documentation></xs:annotation><xs:complexType><xs:annotation><xs:appinfo><algdoc:title>Inline object type</algdoc:title></xs:appinfo><xs:documentation>Nested object structure declaring the inner text field.</xs:documentation></xs:annotation><xs:sequence><xs:element name="inner" type="xs:string"><xs:annotation><xs:appinfo><algdoc:title>Inner</algdoc:title></xs:appinfo>
      <xs:documentation>Specifies the inner associated with this definition.</xs:documentation></xs:annotation>
    </xs:element></xs:sequence></xs:complexType></xs:element>
<xs:element name="anything" minOccurs="1" nillable="true" type="xs:anyType"><xs:annotation><xs:appinfo><algdoc:title>Anything</algdoc:title></xs:appinfo>
