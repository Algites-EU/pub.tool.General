# Algites default JAVA target configuration.
# The target artifact must declare this technology in TechnologyKinds.
# Naming IDs are supplied by the library catalog, not by the generator.
--repository-root=.
--schema-input-dir=xmldefs:src/product/xmldefs
--schema-input-dir=yamldefs:src/product/yamldefs
--schema-input-dir=jsondefs:src/product/jsondefs
--input-schema-naming-convention=xmldefs:algites-xmldef-schema-versioned_1
--input-schema-naming-convention=yamldefs:algites-yamldef-schema-versioned_1
--input-schema-naming-convention=jsondefs:algites-jsondef-schema-versioned_1
--technology-dointf-output-dir=java:src/product/java.gen
--output-interface-technology-naming-convention=java:common:defsintf=algites-java-gen-intf-versioned_1
--output-interface-technology-naming-convention=java:xmldefs_type:defsintf=algites-java-gen-xml-type-intf-versioned_1
--output-interface-technology-naming-convention=java:xmldefs_element:defsintf=algites-java-gen-xml-element-intf-versioned_1
--output-interface-technology-naming-convention=java:xmldefs_namespace:defsintf=algites-java-gen-xml-namespace-intf_1
--output-interface-technology-naming-convention=java:yamldefs:defsintf=algites-java-gen-yaml-intf-versioned_1
--output-interface-technology-naming-convention=java:jsondefs:defsintf=algites-java-gen-json-intf-versioned_1
--output-enum-technology-naming-convention=java:algites-java-gen-enum-versioned_1
--naming-conventions-file=resource:standard-conventions.yml
--naming-conventions-file=resource:algites-java-name-conventions.yml
--naming-conventions-file=resource:algites-xmldef-name-conventions.yml
--naming-conventions-file=resource:algites-yamldef-name-conventions.yml
--naming-conventions-file=resource:algites-jsondef-name-conventions.yml
