# Algites default PYTHON target configuration.
# The target artifact must declare this technology in TechnologyKinds.
# Naming IDs are supplied by the library catalog, not by the generator.
--repository-root=.
--schema-input-dir:xmldefs=src/product/xmldefs
--schema-input-dir:yamldefs=src/product/yamldefs
--schema-input-dir:jsondefs=src/product/jsondefs
--input-schema-naming-convention:xmldefs=algites-xmldef-schema-versioned_1
--input-schema-naming-convention:yamldefs=algites-yamldef-schema-versioned_1
--input-schema-naming-convention:jsondefs=algites-jsondef-schema-versioned_1
--technology-dointf-output-dir:python=src/product/python.gen
--output-interface-technology-naming-convention:python:common:defsintf=algites-python-gen-intf-versioned_1
--output-interface-technology-naming-convention:python:xmldefs_type:defsintf=algites-python-gen-xml-type-intf-versioned_1
--output-interface-technology-naming-convention:python:xmldefs_element:defsintf=algites-python-gen-xml-element-intf-versioned_1
--output-interface-technology-naming-convention:python:xmldefs_namespace:defsintf=algites-python-gen-xml-namespace-intf_1
--output-interface-technology-naming-convention:python:yamldefs:defsintf=algites-python-gen-yaml-intf-versioned_1
--output-interface-technology-naming-convention:python:jsondefs:defsintf=algites-python-gen-json-intf-versioned_1
--output-enum-technology-naming-convention:python=algites-python-gen-enum-versioned_1
--naming-conventions-file:standard=classpath:standard-conventions.yml
--naming-conventions-file:python=classpath:algites-python-name-conventions.yml
--naming-conventions-file:xmldefs=classpath:algites-xmldef-name-conventions.yml
--naming-conventions-file:yamldefs=classpath:algites-yamldef-name-conventions.yml
--naming-conventions-file:jsondefs=classpath:algites-jsondef-name-conventions.yml
--setter-inheritance-policy=INHERIT_AS_GENERIC_PARAMETER
--naming-conventions-file:generated_dataobject=classpath:algites-python-codegen-method-conventions.yml
--generated-dataobject-method-naming-convention:python=algites-python-codegen-standard_1
