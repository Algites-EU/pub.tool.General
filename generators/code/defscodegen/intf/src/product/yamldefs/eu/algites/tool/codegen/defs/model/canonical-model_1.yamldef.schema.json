{
  "$schema": "https://defs.dev.algites.eu/api/jsonmetadefs/eu/algites/tool/codegen/defs/jsonmetadef/2020-12/dialect_1.jsonmetadef.schema.json",
  "$id": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/tool/codegen/defs/model/canonical-model_1.yamldef.schema.json",
  "title": "Canonical Defs Model",
  "description": "Structure model for Defs Codegen. These interfaces are generated by the established Defs Codegen; the new frontend parses and validates values in its impl module.",
  "x-algites-schema-id": "eu.algites.tool.codegen.defs.model.canonical-model",
  "x-algites-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Type"
      }
    }
  },
  "required": [
    "types"
  ],
  "$defs": {
    "StructureKind": {
      "type": "string",
      "enum": [
        "TYPE",
        "ELEMENTLIST",
        "ELEMENT",
        "LIST",
        "MAP",
        "SCALAR",
        "ENUM"
      ],
      "description": "Seven canonical kinds"
    },
    "ElementKind": {
      "type": "string",
      "enum": [
        "REFERENCED",
        "EMBEDDED"
      ],
      "description": "Serialized field with a wire name (REFERENCED) or inline, unnamed structural group (EMBEDDED); independent of TypeOrigin."
    },
    "Composition": {
      "type": "string",
      "enum": [
        "SEQUENCE",
        "ALL",
        "CHOICE"
      ],
      "description": "Group compositor; ALL is ordered for canonical traversal"
    },
    "MapKind": {
      "type": "string",
      "enum": [
        "COMMON_MAP",
        "INTEGRATED_PROPERTY_MAP"
      ],
      "description": "Map participation and property-map policy"
    },
    "TypeOrigin": {
      "type": "string",
      "enum": [
        "DECLARED",
        "SYNTHETIC"
      ],
      "description": "Declared or synthesized during schema loading"
    },
    "ResolutionState": {
      "type": "string",
      "enum": [
        "RESOLVED",
        "REFERENCE",
        "UNDEFINED"
      ],
      "description": "Temporary resolution state on TYPE; only RESOLVED survives finalization"
    },
    "ScalarKind": {
      "type": "string",
      "enum": [
        "ANY",
        "STRING",
        "INTEGER",
        "NUMBER",
        "BOOLEAN",
        "NULL"
      ],
      "description": "Canonical scalar type"
    },
    "SourceInputKind": {
      "type": "string",
      "enum": [
        "XMLDEFS",
        "YAMLDEFS",
        "JSONDEFS"
      ],
      "description": "Schema language provenance"
    },
    "SourceBinding": {
      "type": "object",
      "title": "Exact source binding",
      "description": "Exact source binding",
      "properties": {
        "source_resource": {
          "type": "string"
        },
        "source_pointer": {
          "type": "string"
        },
        "representation_kind": {
          "type": "string"
        }
      },
      "required": [
        "source_resource",
        "source_pointer",
        "representation_kind"
      ],
      "additionalProperties": false
    },
    "SourceBindings": {
      "type": "object",
      "description": "Ordered sequence of source-binding groups matching XMLDEFS SourceBindings.",
      "properties": {
        "SourceBindingGroup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceBindingGroup"
          }
        }
      },
      "additionalProperties": false
    },
    "KeyDefinition": {
      "type": "object",
      "title": "Deferred XML key constraint",
      "description": "Ordered XML xs:key/xs:unique constraint, preserving selector and original field XPath expressions.",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "source_pointer": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Original ordered xs:field XPath expressions, not normalized property getter names."
        },
        "required": {
          "type": "boolean",
          "description": "True for xs:key; false for xs:unique (incomplete tuple allowed)."
        }
      },
      "required": [
        "identifier",
        "selector",
        "source_pointer"
      ],
      "additionalProperties": false
    },
    "EnumValue": {
      "type": "object",
      "title": "Canonical enumeration value",
      "description": "Canonical enumeration value",
      "properties": {
        "wire_value": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        }
      },
      "required": [
        "wire_value"
      ],
      "additionalProperties": false
    },
    "Structure": {
      "type": "object",
      "title": "One of seven canonical shapes",
      "description": "One of seven canonical shapes",
      "x-algites-defscodegen-choice": true,
      "properties": {
        "Type": {
          "$ref": "#/$defs/Type"
        },
        "ElementList": {
          "$ref": "#/$defs/ElementList"
        },
        "Element": {
          "$ref": "#/$defs/Element"
        },
        "List": {
          "$ref": "#/$defs/List"
        },
        "Map": {
          "$ref": "#/$defs/Map"
        },
        "Scalar": {
          "$ref": "#/$defs/Scalar"
        },
        "Enum": {
          "$ref": "#/$defs/Enum"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "Type": {
      "type": "object",
      "title": "Declared or synthetic named type",
      "description": "Declared or synthetic named type",
      "properties": {
        "identity": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/TypeOrigin"
        },
        "path_segments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inherited_from_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "$ref": "#/$defs/TypeContent"
        },
        "resolution_state": {
          "$ref": "#/$defs/ResolutionState"
        },
        "source_bindings": {
          "$ref": "#/$defs/SourceBindings"
        },
        "schema_version": {
          "type": "string",
          "description": "Exact source schema version token, empty if unspecified."
        },
        "description": {
          "type": "string",
          "description": "Documentation associated with the source declaration."
        }
      },
      "required": [
        "identity",
        "name",
        "origin",
        "resolution_state",
        "content"
      ],
      "additionalProperties": false
    },
    "TypeContent": {
      "type": "object",
      "title": "Exactly one nested canonical structure or a resolved symbolic type reference",
      "description": "Exclusive alternative: inline structure or target identity. Canonical Type requires this content after resolution.",
      "x-algites-defscodegen-choice": true,
      "properties": {
        "structure": {
          "$ref": "#/$defs/Structure"
        },
        "target_identity": {
          "type": "string",
          "minLength": 1,
          "description": "Resolved symbolic link to a TYPE declared elsewhere; allows recursion without copying or cycles in value trees."
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "ElementList": {
      "type": "object",
      "title": "Ordered composition of structural children",
      "description": "Ordered composition of structural children",
      "properties": {
        "composition": {
          "$ref": "#/$defs/Composition"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ElementListChild"
          }
        },
        "min_item_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum allowed occurrences, zero if optional."
        },
        "max_item_count": {
          "type": "integer",
          "minimum": -1,
          "description": "Maximum allowed occurrences, -1 for unbounded."
        },
        "min_properties": {
          "type": "integer",
          "description": "Minimum object property count, -1 when unspecified."
        },
        "max_properties": {
          "type": "integer",
          "description": "Maximum object property count, -1 when unspecified."
        }
      },
      "required": [
        "composition",
        "children",
        "min_item_count",
        "max_item_count"
      ],
      "additionalProperties": false
    },
    "Element": {
      "type": "object",
      "title": "Named member",
      "description": "Named member",
      "properties": {
        "element_kind": {
          "$ref": "#/$defs/ElementKind",
          "description": "How this member is placed in its parent ELEMENTLIST."
        },
        "name": {
          "type": "string"
        },
        "structure": {
          "$ref": "#/$defs/Structure"
        },
        "key_definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyDefinition"
          }
        },
        "source_bindings": {
          "$ref": "#/$defs/SourceBindings"
        },
        "min_item_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum allowed occurrences, zero if optional."
        },
        "max_item_count": {
          "type": "integer",
          "minimum": -1,
          "description": "Maximum allowed occurrences, -1 for unbounded."
        },
        "description": {
          "type": "string",
          "description": "Documentation associated with the source field."
        },
        "xml_wire": {
          "$ref": "#/$defs/XmlWireName",
          "description": "Present for XSD-derived members only"
        },
        "default_kind": {
          "type": "string",
          "description": "Empty when unspecified, otherwise DECLARATION_ONLY, IF_FIELD_VALUE_NOT_PRESENT, IF_FIELD_VALUE_EMPTY or CONSTRAINT_DEFAULT."
        },
        "default_value": {
          "type": "string",
          "description": "Lexical schema default or fixed value. Empty string is valid when a kind is present."
        },
        "is_empty_allowed": {
          "type": "boolean",
          "description": "True if the source representation permits explicit empty content."
        }
      },
      "required": [
        "element_kind",
        "name",
        "structure",
        "min_item_count",
        "max_item_count"
      ],
      "additionalProperties": false
    },
    "List": {
      "type": "object",
      "title": "Homogeneous collection",
      "description": "Homogeneous collection",
      "properties": {
        "name": {
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/Structure"
        },
        "min_item_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum allowed occurrences, zero if optional."
        },
        "max_item_count": {
          "type": "integer",
          "minimum": -1,
          "description": "Maximum allowed occurrences, -1 for unbounded."
        },
        "key_definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyDefinition"
          },
          "description": "Source-order indexed keys owned by this collection."
        },
        "xml_wire": {
          "$ref": "#/$defs/XmlWireName",
          "description": "Present for XSD-derived members only"
        },
        "unique_items": {
          "type": "boolean",
          "description": "Whether members must be unique."
        }
      },
      "required": [
        "name",
        "item",
        "min_item_count",
        "max_item_count"
      ],
      "additionalProperties": false
    },
    "Map": {
      "type": "object",
      "title": "Ordinary or integrated property map",
      "description": "Ordinary or integrated property map",
      "properties": {
        "name": {
          "type": "string"
        },
        "map_kind": {
          "$ref": "#/$defs/MapKind"
        },
        "key_type": {
          "$ref": "#/$defs/Structure"
        },
        "value_type": {
          "$ref": "#/$defs/Structure"
        },
        "source_bindings": {
          "$ref": "#/$defs/SourceBindings"
        }
      },
      "required": [
        "name",
        "map_kind",
        "key_type",
        "value_type"
      ],
      "additionalProperties": false
    },
    "Scalar": {
      "type": "object",
      "title": "Canonical scalar value",
      "description": "Canonical scalar value",
      "properties": {
        "scalar_kind": {
          "$ref": "#/$defs/ScalarKind"
        },
        "format": {
          "type": "string"
        },
        "min_length": {
          "type": "integer",
          "description": "Minimum Unicode code-point length, -1 means unspecified."
        },
        "max_length": {
          "type": "integer",
          "description": "Maximum Unicode code-point length, -1 means unspecified."
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression as defined by source language."
        },
        "minimum": {
          "type": "string",
          "description": "Inclusive numeric lower bound, lexical decimal; empty when unspecified."
        },
        "maximum": {
          "type": "string",
          "description": "Inclusive numeric upper bound, lexical decimal; empty when unspecified."
        },
        "exclusive_minimum": {
          "type": "boolean",
          "description": "Whether lower bound is exclusive."
        },
        "exclusive_maximum": {
          "type": "boolean",
          "description": "Whether upper bound is exclusive."
        },
        "multiple_of": {
          "type": "string",
          "description": "Positive numeric divisor, lexical decimal; empty when unspecified."
        }
      },
      "required": [
        "scalar_kind"
      ],
      "additionalProperties": false
    },
    "Enum": {
      "type": "object",
      "title": "Canonical enumeration",
      "description": "Canonical enumeration",
      "properties": {
        "base_scalar_type": {
          "$ref": "#/$defs/ScalarKind"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnumValue"
          }
        }
      },
      "required": [
        "base_scalar_type",
        "values"
      ],
      "additionalProperties": false
    },
    "ElementListChild": {
      "type": "object",
      "title": "One direct child of ELEMENTLIST",
      "description": "One direct child of ELEMENTLIST",
      "x-algites-defscodegen-choice": true,
      "properties": {
        "Element": {
          "$ref": "#/$defs/Element"
        },
        "ElementList": {
          "$ref": "#/$defs/ElementList"
        },
        "List": {
          "$ref": "#/$defs/List"
        },
        "Map": {
          "$ref": "#/$defs/Map"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "XmlWireName": {
      "type": "object",
      "title": "XML wire QName and kind",
      "description": "Exact XML QName independent of schema type identity and generated accessor name.",
      "properties": {
        "namespace_uri": {
          "type": "string",
          "description": "Namespace URI, or empty if unqualified"
        },
        "local_name": {
          "type": "string",
          "minLength": 1,
          "description": "Original XML local part"
        },
        "value_kind": {
          "type": "string",
          "enum": [
            "ELEMENT",
            "ATTRIBUTE"
          ],
          "description": "XML node kind"
        }
      },
      "required": [
        "namespace_uri",
        "local_name",
        "value_kind"
      ],
      "additionalProperties": false
    },
    "SourceBindingGroup": {
      "type": "object",
      "description": "One source technology and its ordered source bindings; same semantic structure as XMLDEFS SourceBindingGroup.",
      "properties": {
        "InputKind": {
          "$ref": "#/$defs/SourceInputKind"
        },
        "Binding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceBinding"
          },
          "minItems": 1
        }
      },
      "required": [
        "InputKind",
        "Binding"
      ],
      "additionalProperties": false
    }
  }
}
