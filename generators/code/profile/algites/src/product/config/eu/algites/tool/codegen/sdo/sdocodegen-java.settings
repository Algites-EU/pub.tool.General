# algites build-time naming profile for sdocodegen / java
--dointf-naming-convention:java=algites-java-gen-intf-versioned_1
--sdointf-naming-convention:java=algites-java-gen-data-intf-versioned_1
--sdoimpl-naming-convention:java=algites-java-gen-data-class-versioned_1
--naming-conventions-file:standard=classpath:standard-conventions.yml
--naming-conventions-file:java=classpath:algites-java-name-conventions.yml
--naming-conventions-file:xmldefs=classpath:algites-xmldef-name-conventions.yml
--naming-conventions-file:yamldefs=classpath:algites-yamldef-name-conventions.yml
--naming-conventions-file:jsondefs=classpath:algites-jsondef-name-conventions.yml
--naming-conventions-file:codegen_common=classpath:algites-java-common-codegen-conventions.yml
--naming-conventions-file:codegen_sdo=classpath:algites-java-sdo-codegen-conventions.yml
--common-codegen-naming-convention:java=algites-java-codegen-common_1
--sdo-codegen-naming-convention:java=algites-java-sdocodegen-standard_1
