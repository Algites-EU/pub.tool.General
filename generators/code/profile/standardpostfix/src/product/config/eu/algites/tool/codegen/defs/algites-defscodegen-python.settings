# standardpostfix build-time naming profile for defscodegen / python
--input-schema-naming-convention:xmldefs=standard-postfix-xmldef-schema-versioned_1
--input-schema-naming-convention:yamldefs=standard-postfix-yamldef-schema-versioned_1
--input-schema-naming-convention:jsondefs=standard-postfix-jsondef-schema-versioned_1
--output-interface-technology-naming-convention:python:common:defsintf=standard-postfix-python-gen-intf-versioned_1
--output-interface-technology-naming-convention:python:xmldefs_type:defsintf=standard-postfix-python-gen-xml-type-intf-versioned_1
--output-interface-technology-naming-convention:python:xmldefs_element:defsintf=standard-postfix-python-gen-xml-element-intf-versioned_1
--output-interface-technology-naming-convention:python:xmldefs_namespace:defsintf=standard-postfix-python-gen-xml-namespace-intf_1
--output-interface-technology-naming-convention:python:yamldefs:defsintf=standard-postfix-python-gen-yaml-intf-versioned_1
--output-interface-technology-naming-convention:python:jsondefs:defsintf=standard-postfix-python-gen-json-intf-versioned_1
--output-enum-technology-naming-convention:python=standard-postfix-python-gen-enum-versioned_1
--naming-conventions-file:standard=classpath:standard-conventions.yml
--naming-conventions-file:python=classpath:standard-postfix-python-name-conventions.yml
--naming-conventions-file:xmldefs=classpath:standard-postfix-xmldef-name-conventions.yml
--naming-conventions-file:yamldefs=classpath:standard-postfix-yamldef-name-conventions.yml
--naming-conventions-file:jsondefs=classpath:standard-postfix-jsondef-name-conventions.yml
--naming-conventions-file:generated_dataobject=classpath:standardpostfix-python-codegen-method-conventions.yml
--generated-dataobject-method-naming-convention:python=standard-postfix-python-codegen-standard_1
