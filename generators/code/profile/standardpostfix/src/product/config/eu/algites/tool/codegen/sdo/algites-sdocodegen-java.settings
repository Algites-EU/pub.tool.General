# standardpostfix build-time naming profile for sdocodegen / java
--dointf-naming-convention:java=standard-postfix-java-gen-intf-versioned_1
--sdointf-naming-convention:java=standard-postfix-java-gen-data-intf-versioned_1
--sdoimpl-naming-convention:java=standard-postfix-java-gen-data-class-versioned_1
--naming-conventions-file:standard=classpath:standard-conventions.yml
--naming-conventions-file:java=classpath:standard-postfix-java-name-conventions.yml
--naming-conventions-file:xmldefs=classpath:standard-postfix-xmldef-name-conventions.yml
--naming-conventions-file:yamldefs=classpath:standard-postfix-yamldef-name-conventions.yml
--naming-conventions-file:jsondefs=classpath:standard-postfix-jsondef-name-conventions.yml
--naming-conventions-file:codegen_common=classpath:standardpostfix-java-common-codegen-conventions.yml
--naming-conventions-file:codegen_sdo=classpath:standardpostfix-java-sdo-codegen-conventions.yml
--common-codegen-naming-convention:java=standardpostfix-java-codegen-common_1
--sdo-codegen-naming-convention:java=standardpostfix-java-sdocodegen-standard_1
