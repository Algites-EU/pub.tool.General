# standardprefix build-time naming profile for defscodegen / python
--input-schema-naming-convention:xmldefs=standard-prefix-xmldef-schema-versioned_1
--input-schema-naming-convention:yamldefs=standard-prefix-yamldef-schema-versioned_1
--input-schema-naming-convention:jsondefs=standard-prefix-jsondef-schema-versioned_1
--dointf-naming-convention:python=standard-prefix-python-gen-intf-versioned_1
--output-enum-technology-naming-convention:python=standard-prefix-python-gen-enum-versioned_1
--naming-conventions-file:standard=classpath:standard-conventions.yml
--naming-conventions-file:python=classpath:standard-prefix-python-name-conventions.yml
--naming-conventions-file:xmldefs=classpath:standard-prefix-xmldef-name-conventions.yml
--naming-conventions-file:yamldefs=classpath:standard-prefix-yamldef-name-conventions.yml
--naming-conventions-file:jsondefs=classpath:standard-prefix-jsondef-name-conventions.yml
--naming-conventions-file:codegen_common=classpath:standardprefix-python-common-codegen-conventions.yml
--naming-conventions-file:codegen_defs=classpath:standardprefix-python-defs-codegen-conventions.yml
--common-codegen-naming-convention:python=standardprefix-python-codegen-common_1
--defs-codegen-naming-convention:python=standardprefix-python-defscodegen-standard_1
