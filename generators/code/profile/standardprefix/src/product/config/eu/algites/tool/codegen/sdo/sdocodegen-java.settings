# standardprefix build-time naming profile for sdocodegen / java
--dointf-naming-convention:java=standard-prefix-java-gen-intf-versioned_1
--sdointf-naming-convention:java=standard-prefix-java-gen-data-intf-versioned_1
--sdoimpl-naming-convention:java=standard-prefix-java-gen-data-class-versioned_1
--naming-conventions-file:standard=classpath:standard-conventions.yml
--naming-conventions-file:java=classpath:standard-prefix-java-name-conventions.yml
--naming-conventions-file:xmldefs=classpath:standard-prefix-xmldef-name-conventions.yml
--naming-conventions-file:yamldefs=classpath:standard-prefix-yamldef-name-conventions.yml
--naming-conventions-file:jsondefs=classpath:standard-prefix-jsondef-name-conventions.yml
--naming-conventions-file:codegen_common=classpath:standardprefix-java-common-codegen-conventions.yml
--naming-conventions-file:codegen_sdo=classpath:standardprefix-java-sdo-codegen-conventions.yml
--common-codegen-naming-convention:java=standardprefix-java-codegen-common_1
--sdo-codegen-naming-convention:java=standardprefix-java-sdocodegen-standard_1
