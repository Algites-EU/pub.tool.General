{
  "$schema": "https://defs.dev.algites.eu/api/jsonmetadefs/eu/algites/tool/codegen/defs/jsonmetadef/2020-12/dialect_1.jsonmetadef.schema.json",
  "$id": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/tool/codegen/sdo/naming/sdocodegen-naming-conventions_1.yamldef.schema.json",
  "title": "SdoCodegenNameConventions",
  "description": "New sdo naming profiles; other-domain roles forbidden.",
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.yamldef.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "SdoCodegenNameConventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "NameConventions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "StructureNaming": {
                "type": "object",
                "propertyNames": {
                  "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/tool/codegen/sdo/naming/sdocodegen-structure-kind_1.yamldef.schema.json"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "properties": {
                  "raw_getter": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional SDO method for reading an unconverted field value."
                  },
                  "raw_presence_checker_method": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional SDO method for checking field presence."
                  },
                  "raw_unsetter": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional SDO method for clearing a field."
                  }
                },
                "description": "Role names are restricted to the sdo domain. Values reference naming compositions except the two literal key/value getters."
              },
              "CommonNamingConvention": {
                "type": "string",
                "minLength": 1,
                "description": "Required ID of the common naming profile providing shared methods and metadata. Resolved across supplied profile documents."
              }
            },
            "required": [
              "CommonNamingConvention",
              "StructureNaming"
            ]
          }
        }
      },
      "required": [
        "NameConventions"
      ]
    }
  },
  "required": [
    "SdoCodegenNameConventions"
  ],
  "x-algites-defscodegen-extends": [
    "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/naming/convention/common-naming-conventions_1.yamldef.schema.json"
  ],
  "x-algites-schema-id": "eu.algites.tool.codegen.sdo.naming.sdocodegen-naming-conventions",
  "x-algites-schema-version": 1
}
